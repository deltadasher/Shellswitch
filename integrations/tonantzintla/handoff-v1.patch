+#!/usr/bin/env python3
+"""Shellswitch handoff v1. Cooperative coordination, not a security boundary."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def marker():
+    path = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "shellswitch/handoff.json"
+    if not path.exists():
+        return None
+    data = json.loads(path.read_text())
+    if data.get("version") != 1 or data.get("contract") != "shellswitch-handoff-v1":
+        raise RuntimeError("Unsupported Shellswitch handoff contract")
+    if not Path(data["state_dir"]).is_absolute() or not Path(data["shellswitch"]).is_absolute():
+        raise RuntimeError("Invalid Shellswitch handoff paths")
+    return data
+
+
+def invoke(data, *args):
+    return [data["shellswitch"], "--state-dir", data["state_dir"], *args]
+
+
+def main():
+    data = marker()
+    if data is None:
+        return
+    args = sys.argv[1:]
+    command = args[0] if args else "help"
+    if command in ("start", "run", "session-start", "restart"):
+        os.execv(data["shellswitch"], invoke(data, "resume", "--shell", "tonantzintla"))
+    if command == "stop":
+        os.execv(data["shellswitch"], invoke(data, "disable", "tonantzintla", "--yes"))
+    # Native install/update is guarded separately. sync is intentionally refused:
+    # it executes a freshly pulled installer whose contract cannot be assumed.
+    if command == "sync":
+        raise RuntimeError("Managed by Shellswitch: update source separately, then shellswitch install MANIFEST --payload ROOT --yes; select the new revision explicitly")
+    if command in ("help", "--help", "-h", "version", "--version", "path", "doctor", "plan", "profile", "install", "update", "uninstall"):
+        return
+    if os.environ.get("SHELLSWITCH_GATED") == "1":
+        subprocess.run(invoke(data, "authorize", "tonantzintla", "--purpose", "runtime"), check=True)
+        return
+    os.execv(data["shellswitch"], invoke(data, "gate", "tonantzintla", "--", *args))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (OSError, ValueError, KeyError, RuntimeError, subprocess.CalledProcessError) as error:
+        print(f"Tonantzintla handoff: {error}", file=sys.stderr)
+        sys.exit(1)
