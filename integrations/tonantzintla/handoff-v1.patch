+"""Native contract tests; all configuration, commands and daemon paths isolated."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+
+class HandoffTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.config = self.root / "config"
+        (self.config / "shellswitch").mkdir(parents=True)
+        self.trace = self.root / "trace"
+        fake = self.root / "shellswitch"
+        fake.write_text('#!/bin/sh\nprintf "%s\\n" "$*" >> "$TRACE"\nexit "${FAKE_STATUS:-0}"\n')
+        fake.chmod(0o755)
+        self.marker = self.config / "shellswitch/handoff.json"
+        self.marker.write_text(json.dumps(dict(version=1, contract="shellswitch-handoff-v1", state_dir=str(self.root / "state"), shellswitch=str(fake))))
+        self.env = dict(os.environ, HOME=str(self.root), XDG_CONFIG_HOME=str(self.config), TRACE=str(self.trace))
+        self.env.pop("SHELLSWITCH_GATED",None)
+    def cli(self, *args, status="0"):
+        return subprocess.run([str(ROOT / "bin/blackhole"), *args],env=dict(self.env,FAKE_STATUS=status),capture_output=True,text=True,timeout=5)
+    def test_start_is_routed_once_and_inactive_denial_propagates(self):
+        self.assertEqual(self.cli("start").returncode,0)
+        self.assertIn("resume --shell tonantzintla",self.trace.read_text())
+        self.assertEqual(len(self.trace.read_text().splitlines()),1)
+        self.assertNotEqual(self.cli("session-start",status="1").returncode,0)
+    def test_shortcut_gate_and_emergency_stop(self):
+        self.assertEqual(self.cli("bar-edit").returncode,0)
+        self.assertIn("gate tonantzintla -- bar-edit",self.trace.read_text())
+        self.assertEqual(self.cli("stop").returncode,0)
+        self.assertIn("disable tonantzintla --yes",self.trace.read_text())
+    def test_direct_supervisor_and_respawn_refuse_managed_mode(self):
+        p = ROOT / "src/libexec/session-daemon.py"
+        result = subprocess.run(["python3",str(p),"start"],env=self.env,capture_output=True,text=True,timeout=5)
+        self.assertNotEqual(result.returncode,0)
+        self.assertIn("Shellswitch owns",result.stderr)
+        spec = importlib.util.spec_from_file_location("daemon",p)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        with patch.dict(os.environ,self.env):
+            with self.assertRaises(RuntimeError):
+                module.assert_unmanaged() # called before every respawn
+    def test_invalid_record_and_sync_fail_before_mutation(self):
+        self.assertNotEqual(self.cli("sync").returncode,0)
+        self.assertFalse(self.trace.exists())
+        self.marker.write_text("broken")
+        self.assertNotEqual(self.cli("start").returncode,0)
+        self.assertFalse(self.trace.exists())
+    def test_forged_gated_flag_still_requires_valid_lease(self):
+        self.env["SHELLSWITCH_GATED"] = "1"
+        self.assertNotEqual(self.cli("toggle","menu",status="1").returncode,0)
+        self.assertIn("authorize tonantzintla --purpose runtime",self.trace.read_text())
+
+if __name__ == '__main__': unittest.main()
