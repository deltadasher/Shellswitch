+//! Shared ownership lock for native installation. Shellswitch activates separately.
+use anyhow::{Result, ensure};
+use serde_json::Value;
+use std::{
+    fs::{self, File, OpenOptions},
+    path::Path,
+};
+
+pub fn managed(config: &Path) -> bool {
+    config.join("shellswitch/handoff.json").exists()
+}
+
+pub fn installation_lock(config: &Path) -> Result<Option<File>> {
+    if !managed(config) {
+        return Ok(None);
+    }
+    let record: Value =
+        serde_json::from_slice(&fs::read(config.join("shellswitch/handoff.json"))?)?;
+    ensure!(
+        record["version"] == 1 && record["contract"] == "shellswitch-handoff-v1",
+        "Unsupported Shellswitch handoff contract"
+    );
+    let root = Path::new(
+        record["state_dir"]
+            .as_str()
+            .ok_or_else(|| anyhow::anyhow!("Missing state_dir"))?,
+    );
+    ensure!(root.is_absolute(), "Invalid Shellswitch state directory");
+    let lock = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(root.join("lock"))?;
+    lock.lock()?;
+    let state: Value = serde_json::from_slice(&fs::read(root.join("state.json"))?)?;
+    ensure!(
+        state["schema"] == 2
+            && state["pending"].is_null()
+            && !root.join("files-pending.json").exists(),
+        "Recover the Shellswitch transaction before installing"
+    );
+    Ok(Some(lock))
+}
