+#[test]
+fn managed_install_preserves_niri_and_command_gate_and_rejects_replace() {
+    let sandbox = Sandbox::new("1.0.0");
+    let state = sandbox.state.join("shellswitch");
+    fs::create_dir_all(&state).unwrap();
+    fs::write(state.join("lock"), "").unwrap();
+    fs::write(state.join("state.json"), r#"{"schema":2,"pending":null}"#).unwrap();
+    fs::create_dir_all(sandbox.config.join("shellswitch")).unwrap();
+    fs::write(
+        sandbox.config.join("shellswitch/handoff.json"),
+        serde_json::to_vec(
+            &serde_json::json!({"version":1,"contract":"shellswitch-handoff-v1","state_dir":state}),
+        )
+        .unwrap(),
+    )
+    .unwrap();
+    fs::create_dir_all(sandbox.config.join("niri")).unwrap();
+    let niri = sandbox.config.join("niri/config.kdl");
+    fs::write(&niri, "// active foreign shell and custom settings\n").unwrap();
+    fs::create_dir_all(sandbox.home.join(".local/bin")).unwrap();
+    let gate = sandbox.home.join(".local/bin/blackhole");
+    executable(&gate, "#!/bin/sh\n# owned gate\nexit 77\n");
+    let before = fs::read(&gate).unwrap();
+    let result = sandbox.apply(&["--niri", "keep"]);
+    assert!(
+        result.status.success(),
+        "{}",
+        String::from_utf8_lossy(&result.stderr)
+    );
+    assert_eq!(fs::read(&gate).unwrap(), before);
+    assert_eq!(
+        fs::read_to_string(&niri).unwrap(),
+        "// active foreign shell and custom settings\n"
+    );
+    let result = sandbox.apply(&["--niri", "replace"]);
+    assert!(!result.status.success());
+    assert!(String::from_utf8_lossy(&result.stderr).contains("Shellswitch owns Niri"));
+    fs::write(state.join("files-pending.json"), "{}").unwrap();
+    assert!(!sandbox.apply(&["--niri", "keep"]).status.success());
+    fs::remove_file(state.join("files-pending.json")).unwrap();
+    fs::write(sandbox.config.join("shellswitch/handoff.json"), "broken").unwrap();
+    assert!(!sandbox.apply(&["--niri", "keep"]).status.success());
+}
